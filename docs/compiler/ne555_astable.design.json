{
  "version": 1,
  "project": "ne555_astable",
  "description": "NE555 astable: R1/R2 timing chain, C1 timing cap, C2 on CONT, LED on OUT",
  "sheet": "auto",

  "blocks": [
    {
      "name": "input",
      "symbols": [
        { "ref": "J1", "lib": "Connector_Generic:Conn_01x02", "value": "VCC 5-15V", "mirror": true }
      ]
    },
    {
      "name": "astable",
      "symbols": [
        { "ref": "U1", "lib": "Timer:NE555P", "value": "NE555" },

        { "ref": "R1", "lib": "Device:R", "value": "10k",
          "place": { "pin": "2", "at": "U1.7", "dir": "left", "cells": 6 } },
        { "ref": "R2", "lib": "Device:R", "value": "47k",
          "place": { "pin": "1", "at": "R1.2", "dir": "down", "cells": 2 } },
        { "ref": "C1", "lib": "Device:C", "value": "10n",
          "place": { "pin": "1", "at": "R2.2", "dir": "down", "cells": 4 } },

        { "ref": "C2", "lib": "Device:C", "value": "10n", "rot": 180,
          "place": { "pin": "1", "at": "U1.5", "dir": "up", "cells": 2 } },

        { "ref": "R3", "lib": "Device:R", "value": "330", "rot": 90,
          "place": { "pin": "1", "at": "U1.3", "dir": "right", "cells": 4 } },
        { "ref": "D1", "lib": "Device:LED", "value": "LED", "rot": 90,
          "place": { "pin": "A", "at": "R3.2", "dir": "right", "cells": 3 } }
      ]
    },
    {
      "name": "output",
      "symbols": [
        { "ref": "J2", "lib": "Connector_Generic:Conn_01x02", "value": "OUT" }
      ]
    }
  ],

  "arrange": [
    ["input", "astable", "output"]
  ],

  "nets": {
    "VCC":   ["J1.1", "U1.8", "U1.4", "R1.1"],
    "GND":   ["J1.2", "U1.1", "C1.2", "C2.2", "D1.K", "J2.2"],
    "DISCH": ["U1.7", "R1.2", "R2.1"],
    "THR":   ["U1.6", "U1.2", "R2.2", "C1.1"],
    "CTL":   ["U1.5", "C2.1"],
    "OUT":   ["U1.3", "R3.1", "J2.1"],
    "_ANODE": ["R3.2", "D1.A"]
  },

  "power_nets": { "VCC": "power:VCC", "GND": "power:GND" }
}
