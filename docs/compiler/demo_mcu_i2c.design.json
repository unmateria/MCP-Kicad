{
  "version": 1,
  "project": "demo_mcu_i2c",
  "description": "ATmega328 + I2C pull-ups + 4x decoupling caps + 16 MHz crystal",
  "sheet": "auto",

  "blocks": [
    {
      "name": "input",
      "symbols": [
        { "ref": "J1", "lib": "Connector_Generic:Conn_01x02", "value": "VCC 5V", "mirror": true }
      ]
    },
    {
      "name": "mcu",
      "symbols": [
        { "ref": "U1", "lib": "MCU_Microchip_ATmega:ATmega328-A", "value": "ATmega328" },

        { "ref": "C1", "lib": "Device:C", "value": "100n",
          "place": { "pin": "1", "at": "U1.VCC", "dir": "left", "cells": 8 } },
        { "ref": "C2", "lib": "Device:C", "value": "100n",
          "place": { "pin": "1", "at": "C1.1", "dir": "left", "cells": 5 } },
        { "ref": "C3", "lib": "Device:C", "value": "100n",
          "place": { "pin": "1", "at": "C2.1", "dir": "left", "cells": 5 } },
        { "ref": "C4", "lib": "Device:C", "value": "10u",
          "place": { "pin": "1", "at": "C3.1", "dir": "left", "cells": 5 } },

        { "ref": "Y1", "lib": "Device:Crystal", "value": "16MHz", "rot": 270,
          "place": { "pin": "1", "at": "U1.7", "dir": "right", "cells": 6 } },
        { "ref": "C5", "lib": "Device:C", "value": "22p", "rot": 90,
          "place": { "pin": "1", "at": "Y1.1", "dir": "right", "cells": 3 } },
        { "ref": "C6", "lib": "Device:C", "value": "22p", "rot": 90,
          "place": { "pin": "1", "at": "Y1.2", "dir": "right", "cells": 3 } }
      ]
    },

    {
      "name": "i2c",
      "template": "i2c_pullups",
      "refs": { "R_SDA": "R1", "R_SCL": "R2" },
      "connect": { "SDA": "SDA", "SCL": "SCL", "VCC": "VCC" }
    },

    {
      "name": "output",
      "symbols": [
        { "ref": "J2", "lib": "Connector_Generic:Conn_01x03", "value": "I2C" }
      ]
    }
  ],

  "arrange": [
    ["input", "mcu", "i2c", "output"]
  ],

  "nets": {
    "VCC":   ["J1.1", "U1.VCC", "U1.AVCC", "C1.1", "C2.1", "C3.1", "C4.1"],
    "GND":   ["J1.2", "U1.GND", "C1.2", "C2.2", "C3.2", "C4.2", "C5.2", "C6.2", "J2.3"],
    "SDA":   ["U1.27", "J2.1"],
    "SCL":   ["U1.28", "J2.2"],
    "XTAL1": ["U1.7", "Y1.1", "C5.1"],
    "XTAL2": ["U1.8", "Y1.2", "C6.1"]
  },

  "power_nets": { "VCC": "power:VCC", "GND": "power:GND" },

  "no_connect": { "U1": "unused" }
}
