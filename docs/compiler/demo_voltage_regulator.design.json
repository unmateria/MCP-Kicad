{
  "version": 1,
  "project": "demo_voltage_regulator",
  "description": "LM7805 with input/output caps + power-on LED indicator",
  "sheet": "auto",

  "blocks": [
    {
      "name": "input",
      "symbols": [
        { "ref": "J1", "lib": "Connector_Generic:Conn_01x02", "value": "VIN 7-12V", "mirror": true }
      ]
    },
    {
      "name": "power",
      "template": "voltage_regulator_linear",
      "refs": {
        "REG": "U1",
        "C_IN_BYP": "C1",
        "C_IN_BULK": "C2",
        "C_OUT_BYP": "C3",
        "C_OUT_BULK": "C4",
        "R_LED": "R1",
        "LED": "D1"
      },
      "connect": { "VIN": "VIN", "VOUT": "+5V" }
    },
    {
      "name": "output",
      "symbols": [
        { "ref": "J2", "lib": "Connector_Generic:Conn_01x02", "value": "VOUT 5V" }
      ]
    }
  ],

  "arrange": [
    ["input", "power", "output"]
  ],

  "nets": {
    "VIN": ["J1.1"],
    "+5V": ["J2.1"],
    "GND": ["J1.2", "J2.2"]
  },

  "power_nets": { "GND": "power:GND", "+5V": "power:+5V" }
}
