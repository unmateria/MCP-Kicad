{
  "version": 1,
  "project": "probe_overpin",
  "description": "Lab case: a straight SIG wire from R1.1 to R3.1 passes exactly over R2.1",
  "sheet": "A4",

  "blocks": [
    {
      "name": "probe",
      "symbols": [
        { "ref": "R1", "lib": "Device:R", "value": "1k" },
        { "ref": "R2", "lib": "Device:R", "value": "2k",
          "place": { "pin": "1", "at": "R1.1", "dir": "right", "cells": 6 } },
        { "ref": "R3", "lib": "Device:R", "value": "3k",
          "place": { "pin": "1", "at": "R2.1", "dir": "right", "cells": 6 } }
      ]
    }
  ],

  "nets": {
    "SIG":   ["R1.1", "R3.1"],
    "OTHER": ["R2.1"],
    "GND":   ["R1.2", "R2.2", "R3.2"]
  },

  "power_nets": { "GND": "power:GND" }
}
