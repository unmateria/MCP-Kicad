; Copy this file to config.ini and edit it. Every key is optional: with an
; empty config.ini (or none at all) the server auto-detects a KiCad install
; and uses the defaults noted below.

[paths]
; Path to the kicad-cli executable. Auto-detected if left empty:
;   Windows  C:\Program Files\KiCad\<version>\bin\kicad-cli.exe
;   Linux    /usr/bin/kicad-cli, /usr/local/bin/kicad-cli, then PATH
;   macOS    /Applications/KiCad/KiCad.app/Contents/MacOS/kicad-cli
kicad_cli =

; KiCad's global symbol library directory.
; Default: derived from kicad_cli (<kicad root>/share/kicad/symbols).
kicad_symbols =

; KiCad's global footprint library directory.
; Default: derived from kicad_cli (<kicad root>/share/kicad/footprints).
kicad_footprints =

; Where imported and project-local libraries are kept. Default: "libs".
; A relative path is resolved against the server executable, because Claude
; Desktop launches the server from its own working directory.
;
; import_part writes into this tree:
;   <libs_root>/symbols/MCP_Imported.kicad_sym
;   <libs_root>/footprints/MCP_Imported.pretty/
;   <libs_root>/3dmodels/
;   <libs_root>/cache/<provider>/     provider indexes, refreshed on demand
libs_root =

; Where generated schematics, SVGs and PDFs are written.
; Default: <your home directory>/mcp-kicad/output
output_dir =

; Optional: path to the freerouting JAR for PCB auto-routing (not implemented yet).
freerouting =

[api_keys]
; Distributor APIs. These are an IDENTIFICATION layer only: no distributor
; serves KiCad files, so find_part uses them to resolve an ambiguous part
; number into a real MPN, manufacturer, package and datasheet before looking
; for CAD files in the library sources. Every source that actually carries
; symbols and footprints (CERN, JLCPCB, manufacturer repos, LCSC/EasyEDA)
; needs no key at all.

; Mouser search API key: https://www.mouser.com/api-hub/
mouser =

; Digi-Key Product Information v4, OAuth2 client_credentials.
; Register an app at https://developer.digikey.com/ and paste both halves.
digikey_client_id =
digikey_client_secret =

; PCBWay token. Parsed but unused for now.
pcbway =
